FROM python:3.14-slim
WORKDIR /app
# Portable top-level versions; Windows-specific dependency closure is separate.
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir '.[deep,onnx]'
COPY scripts ./scripts
COPY configs ./configs
COPY dashboard.py ./
COPY .streamlit ./.streamlit
EXPOSE 8000
CMD ["uvicorn","vision_qc.api:create_app","--factory","--host","0.0.0.0","--port","8000"]
